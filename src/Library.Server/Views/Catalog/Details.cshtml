@model BookDto
@{ ViewData["Title"] = Model.Title; }
<a href="/" class="ui-button ui-button--text">← Về bộ sưu tập</a><section class="detail-grid"><img class="detail-cover" src="@Url.Content("~/"+Model.ImagePath)" alt="Bìa @Model.Title"/><div><p class="ui-eyebrow">@Model.Category</p><h1 class="ui-title">@Model.Title</h1><p class="ui-lead">@Model.Authors</p><p class="ui-prose">@Model.Description</p><hr class="ui-divider"/><p>ISBN @Model.Isbn · @Model.Publisher · @Model.Year</p><div class="ui-notice">● @Model.Available bản có sẵn trên tổng @Model.TotalCopies bản sao.</div><p class="ui-help">Số bản có sẵn được cập nhật khi tải trang. Vui lòng đến quầy với thẻ bạn đọc để mượn sách.</p></div></section>
