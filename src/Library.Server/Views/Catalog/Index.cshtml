@model Page<BookDto>
@{ ViewData["Title"] = "Khám phá sách"; var meta = (MetadataDto)ViewBag.Metadata; }
<section class="hero"><div><p class="ui-eyebrow ui-eyebrow--line">ĐỌC HÔM NAY · MỞ LỐI NGÀY MAI</p><h1 class="ui-title">Một cuốn sách.<br/>Một <em>chân trời mới.</em></h1><p class="ui-lead">Tìm tài liệu cho bài học tiếp theo, hay một câu chuyện để chậm lại. Không gian tri thức luôn dành chỗ cho bạn.</p><a class="ui-button ui-button--primary" href="#catalog">Khám phá bộ sưu tập ↓</a></div>
<aside class="ui-card ui-card--dark"><p class="ui-eyebrow">GÓC ĐỌC MỖI NGÀY</p><h2 class="ui-heading">“Học không phải để biết thêm, mà để nhìn khác đi.”</h2><div class="reading-art"><span>tri<br/><em>thức.</em></span></div><p class="ui-prose">Tra cứu trực tuyến. Mượn và trả tại quầy thư viện.</p></aside></section>
<section id="catalog" class="ui-section"><div class="ui-section-heading"><span class="ui-section-number">01 /</span><h2>Bộ sưu tập dành cho bạn</h2><span class="ui-badge">@Model.Total ĐẦU SÁCH</span></div>
<form method="get" class="ui-card search-panel"><label class="ui-field search-main">Bạn đang tìm cuốn sách nào?<input name="q" value="@ViewBag.Query" placeholder="Tên sách, tác giả hoặc ISBN…"/></label><label class="ui-field">Thể loại<select name="category"><option value="">Tất cả thể loại</option>@foreach (var c in meta.Categories) {<option value="@c.Id" selected="@(ViewBag.Category == c.Id)">@c.Name</option>}</select></label><label class="ui-field">Tác giả<select name="author"><option value="">Tất cả tác giả</option>@foreach (var a in meta.Authors) {<option value="@a.Id" selected="@(ViewBag.Author == a.Id)">@a.Name</option>}</select></label><label class="ui-choice"><input type="checkbox" name="available" value="true" checked="@ViewBag.Available"/> Còn sách</label><button class="ui-button ui-button--primary">Tìm sách</button></form>
@if (Model.Total == 0) {<div class="ui-empty mt-4">Chưa tìm thấy sách phù hợp. Hãy thử một từ khóa khác.</div>}
<div class="book-grid">@foreach (var b in Model.Items) {<article class="ui-card book-card"><a asp-action="Details" asp-route-id="@b.Id"><img src="@Url.Content("~/" + b.ImagePath)" alt="Bìa @b.Title"/><span class="ui-badge">@b.Category</span><h2 class="ui-heading">@b.Title</h2><p class="ui-prose">@b.Authors</p><div class="ui-row ui-row--between"><span class="availability">● @b.Available / @b.TotalCopies bản có sẵn</span><span>↗</span></div></a></article>}</div>
<partial name="_CatalogPager" model="Model"/></section>
