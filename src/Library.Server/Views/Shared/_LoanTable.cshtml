@model Page<LoanDto>
<div class="ui-card mt-3 table-responsive"><table class="table"><thead><tr><th>Phiếu / Bản sao</th><th>Đầu sách</th><th>Ngày mượn</th><th>Hạn trả</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var l in Model.Items) {<tr><td><a asp-controller="MyLoans" asp-action="Details" asp-route-id="@l.LoanId">#@l.LoanId</a> · @l.CopyCode</td><td>@l.Title</td><td>@l.BorrowedAt.AddHours(7).ToString("dd/MM/yyyy")</td><td>@l.DueDate.ToString("dd/MM/yyyy")</td><td>@if(l.ReturnedAt.HasValue) {<span>Đã trả @l.ReturnedAt.Value.AddHours(7).ToString("dd/MM/yyyy")</span>} else if(l.DaysOverdue > 0) {<span class="ui-field-error">Quá hạn @l.DaysOverdue ngày</span>} else {<span>Đang mượn</span>}</td></tr>}</tbody></table>@if(Model.Total == 0) {<p class="ui-empty">Chưa có giao dịch trong khoảng thời gian này.</p>}</div>
